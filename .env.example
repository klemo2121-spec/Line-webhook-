# Feature off until server secrets and sandbox checks are complete.
RECEIPTS_ENABLED=false
FLOWACCOUNT_WRITE_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
RECEIPT_MODEL=gpt-4o-mini
# Comma-separated, exact LINE group/user IDs. No wildcard permissions.
EXPENSE_GROUP_IDS=
EXPENSE_USER_IDS=
# Use NEW private Redis credentials, never the legacy cashier credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Confirm environment-specific URLs with your FlowAccount API credentials.
FLOWACCOUNT_API_BASE_URL=https://openapi.flowaccount.com/sandbox
FLOWACCOUNT_TOKEN_URL=https://openapi.flowaccount.com/test/token
FLOWACCOUNT_CLIENT_ID=
FLOWACCOUNT_CLIENT_SECRET=
# Optional short-lived alternative for sandbox testing only:
FLOWACCOUNT_ACCESS_TOKEN=
FLOWACCOUNT_COMPANY_ID=
# Existing company recording policy, explicitly selected after reviewing old records.
FLOWACCOUNT_RECORDING_POLICY=gross_no_input_vat
# Server-only category templates from GET /expenses/categories/business.
FLOWACCOUNT_EXPENSE_CATEGORIES_JSON={}
# Existing monthly document bindings: {"2026-10:petty_cash":12345}
# Keep customer-specific IDs out of this public repository.
FLOWACCOUNT_MONTHLY_DOCUMENTS_JSON={}

# Existing cashier database, separately configured from receipt storage.
CASHIER_UPSTASH_REDIS_REST_URL=
CASHIER_UPSTASH_REDIS_REST_TOKEN=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
# External scheduler may send the same header or existing ?key=<secret> contract.
CRON_SECRET=

# Keep previously disabled translator/cashier/reminders off on the expense project.
LEGACY_BOTS_ENABLED=false

# Persistent MCP OAuth connection. Independent of paid OpenAPI credentials.
# Keep off until private Redis, LINE signature secret and allowlists are ready.
MCP_CONNECTIONS_ENABLED=false
# Canonical deployment origin only, no trailing slash and no URL path.
APP_BASE_URL=
# 32 random bytes, base64-encoded. Server-only; never commit a real value.
FLOWACCOUNT_OAUTH_ENCRYPTION_KEY=
